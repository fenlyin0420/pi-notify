{
	"name": "@fenlyin/pi-notify",
	"version": "0.2.0",
	"description": "Pi package that plays a configurable sound when a dialog waits for the user or an agent run settles.",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"notifications",
		"sound",
		"bell"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fenlyin0420/pi-notify.git"
	},
	"homepage": "https://github.com/fenlyin0420/pi-notify#readme",
	"bugs": {
		"url": "https://github.com/fenlyin0420/pi-notify/issues"
	},
	"files": [
		"src/",
		"assets/",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"scripts": {
		"test": "node --test tests/*.test.ts",
		"typecheck": "tsc -p tsconfig.json",
		"generate-sound": "node scripts/generate-sound.mjs"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.6.0",
		"@types/node": "22.19.19",
		"typescript": "6.0.2"
	},
	"author": "fenlyin0420",
	"publishConfig": {
		"access": "public"
	}
}
